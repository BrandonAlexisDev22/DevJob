# Copia este archivo a .env y completa los valores.
# El entorno se elige con DJANGO_SETTINGS_MODULE (config.settings.dev | staging | prod).
# Por defecto manage.py usa config.settings.dev.

# Clave secreta de Django. Genera una nueva para cada entorno, no reutilices la de otro.
SECRET_KEY=

# Solo "True" en desarrollo. En staging y prod se ignora (siempre False).
DEBUG=True

# Hosts permitidos, separados por coma. Obligatorio en prod.
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL. Si DB_NAME está vacío se usa SQLite local.
DB_NAME=devjob
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
